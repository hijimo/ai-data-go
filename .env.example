# 环境配置示例文件
# 复制此文件为 .env 并填写实际值

# ========================================
# 应用环境
# ========================================
APP_ENV=development
# 可选值: development, production, test

# ========================================
# 服务器配置
# ========================================
SERVER_PORT=8080
SERVER_HOST=0.0.0.0

# ========================================
# Genkit AI 配置
# ========================================
# Google AI API密钥（必需）
GENKIT_API_KEY=your-google-ai-api-key-here
# 或使用 GEMINI_API_KEY
# GEMINI_API_KEY=your-google-ai-api-key-here

# 默认模型
GENKIT_MODEL=gemini-2.5-flash

# 默认温度参数 (0-2)
GENKIT_DEFAULT_TEMPERATURE=0.7

# 默认最大token数
GENKIT_DEFAULT_MAX_TOKENS=2000

# ========================================
# 数据库配置
# ========================================
# 方式1: 使用连接URL（推荐）
DATABASE_URL=postgres://postgres:postgres@localhost:5432/genkit_ai_service?sslmode=disable

# 方式2: 使用独立配置项
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=your-db-password
# DB_NAME=genkit_ai_service
# DB_SSLMODE=disable

# 数据库连接池配置
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m

# 数据库日志级别: silent, error, warn, info
DB_LOG_LEVEL=warn

# ========================================
# Redis 配置
# ========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_ENABLED=true

# ========================================
# 日志配置
# ========================================
# 日志级别: debug, info, warn, error
LOG_LEVEL=info

# 日志格式: json, text
LOG_FORMAT=json

# 是否启用文件日志
LOG_ENABLE_FILE=true

# 日志目录
LOG_DIR=logs

# 是否同时输出到控制台
LOG_ENABLE_CONSOLE=true

# ========================================
# 会话配置
# ========================================
SESSION_TIMEOUT=30m
SESSION_CLEANUP_INTERVAL=5m
SESSION_SUMMARY_THRESHOLD=50
SESSION_DEFAULT_PAGE_SIZE=20
SESSION_MAX_PAGE_SIZE=100
SESSION_MAX_TITLE_LENGTH=255

# ========================================
# 模型配置
# ========================================
MODELS_DIR=./models

# ========================================
# 认证配置
# ========================================
# JWT签名密钥（必需，至少32字符）
JWT_SECRET=your-jwt-secret-key-min-32-characters-long

# JWT签发者
JWT_ISSUER=genkit-ai-service

# JWT受众
JWT_AUDIENCE=genkit-api

# Access Token有效期
ACCESS_TOKEN_TTL=60m

# Refresh Token有效期
REFRESH_TOKEN_TTL=720h

# Bcrypt加密强度 (4-31，推荐10-12)
BCRYPT_COST=12

# 最大登录尝试次数
MAX_LOGIN_ATTEMPTS=5

# 登录尝试时间窗口
LOGIN_ATTEMPT_WINDOW=15m

# 密码最小长度
PASSWORD_MIN_LENGTH=8

# 是否启用Refresh Token轮换
ENABLE_REFRESH_ROTATION=true

# 租户识别策略: header, subdomain, path, cookie
TENANT_IDENTIFY_STRATEGY=header

# Token清理间隔
TOKEN_CLEANUP_INTERVAL=1h

# 是否启用Token黑名单
ENABLE_TOKEN_BLACKLIST=true

# ========================================
# 系统初始化配置
# ========================================
# 平台管理员邮箱（必需）
PLATFORM_ADMIN_EMAIL=admin@system.local

# 平台管理员初始密码（留空则自动生成）
PLATFORM_ADMIN_PASSWORD=

# 平台管理员显示名称
PLATFORM_ADMIN_NAME=Platform Admin

# 平台租户名称
PLATFORM_TENANT_NAME=Platform

# 平台租户域名
PLATFORM_TENANT_DOMAIN=system.local

# ========================================
# 监控配置（可选）
# ========================================
# Prometheus端口
# PROMETHEUS_PORT=9090

# Jaeger端点
# JAEGER_ENDPOINT=http://localhost:14268/api/traces

# ========================================
# 其他配置
# ========================================
# 配置文件路径（可选，直接指定配置文件）
# CONFIG_FILE=/path/to/config.yaml

# 配置目录（可选，默认为 config）
# CONFIG_DIR=config
