# AI服务平台环境变量配置示例
# 复制此文件为.env并填入实际值

# 服务器配置
SERVER_PORT=8080
SERVER_HOST=0.0.0.0

# lexiang
LEXIANG_APP_KEY=your_app_key
LEXIANG_APP_SECRET=your_app_secret
LEXIANG_STAFF_ID=your_staff_id
# AI服务配置
AI_PROVIDER=gemini
AI_API_KEY=your_ai_api_key_here
AI_DEFAULT_MODEL=gemini-1.5-flash

# 数据库配置
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ai_service
DB_USER=postgres
DB_PASSWORD=you password
DB_SSL_MODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m
DB_LOG_LEVEL=warn

# 向量数据库
QDRANT_ACCESS_KEY=
QDRANT_ENDPOINT=
QDRANT_CLUSTER_ID=

# 日志配置
LOG_LEVEL=info
LOG_FORMAT=json
# 是否启用文件日志（按天存储）
LOG_ENABLE_FILE=true
# 日志文件目录
LOG_DIR=logs
# 是否同时输出到控制台
LOG_ENABLE_CONSOLE=true

# 配置文件路径（可选）
CONFIG_FILE=configs/config.yaml

# JWT 认证配置
# JWT 签名密钥（生产环境必须使用强随机密钥，至少 32 个字符）
JWT_SECRET=
# JWT 签发者
JWT_ISSUER=genkit-ai-service
# JWT 受众
JWT_AUDIENCE=genkit-api
# Access Token 生命周期
ACCESS_TOKEN_TTL=60m
# Refresh Token 生命周期（30 天）
REFRESH_TOKEN_TTL=720h

# 密码配置
# Bcrypt cost factor (4-31，推荐 12)
BCRYPT_COST=12
# 密码最小长度
PASSWORD_MIN_LENGTH=8

# 登录安全配置
# 最大登录尝试次数
MAX_LOGIN_ATTEMPTS=5
# 登录尝试时间窗口
LOGIN_ATTEMPT_WINDOW=15m

# Token 策略
# 是否启用 Refresh Token 轮换
ENABLE_REFRESH_ROTATION=true

# 租户识别策略 (header, subdomain, path, cookie)
TENANT_IDENTIFY_STRATEGY=header

# 数据库清理配置
# Token 清理间隔（默认 1 小时）
TOKEN_CLEANUP_INTERVAL=1h

# Redis 配置
# 是否启用 Redis
REDIS_ENABLED=true
# Redis 主机
REDIS_HOST=localhost
# Redis 端口
REDIS_PORT=6379
# Redis 密码（如果没有密码则留空）
REDIS_PASSWORD= your password
# Redis 数据库编号（0-15）
REDIS_DB=0

# Token 黑名单配置
# 是否启用 Token 黑名单（需要 Redis）
ENABLE_TOKEN_BLACKLIST=true
# Genkit AI 配置
GENKIT_API_KEY=
GENKIT_MODEL=gemini-2.5-flash
GENKIT_DEFAULT_TEMPERATURE=0.7
GENKIT_DEFAULT_MAX_TOKENS=2000

# 缓存 TTL 配置（秒）
# 会话上下文缓存：5分钟
CACHE_CONTEXT_TTL=300
# 向量查询结果缓存：30分钟
CACHE_VECTOR_RESULT_TTL=1800
# 摘要缓存：1小时
CACHE_SUMMARY_TTL=3600
# 会话列表缓存：10分钟
CACHE_SESSION_LIST_TTL=600
# Token使用统计缓存：5分钟
CACHE_TOKEN_USAGE_TTL=300

# 系统初始化配置
# 平台管理员邮箱
PLATFORM_ADMIN_EMAIL=you account
# 平台管理员初始密码（留空则自动生成）
PLATFORM_ADMIN_PASSWORD=you password
# 平台管理员显示名称
PLATFORM_ADMIN_NAME=Platform Admin
# 平台租户名称
PLATFORM_TENANT_NAME=Platform
# 平台租户域名
PLATFORM_TENANT_DOMAIN=system.local

# 模型配置加密
# API密钥加密密钥（必须是32字节，生产环境必须使用强随机密钥）
ENCRYPTION_SECRET_KEY=your-32-byte-secret-key-here!!
# 模型配置验证超时时间（秒）
PROVIDER_VALIDATION_TIMEOUT=30

# 追踪配置
# 是否启用追踪
TRACING_ENABLED=true
# 服务名称
TRACING_SERVICE_NAME=genkit-ai-service
# 服务版本
TRACING_SERVICE_VERSION=1.0.0
# 环境（development/staging/production）
TRACING_ENVIRONMENT=development
# OTLP 端点地址（支持 Jaeger v1.35+、Tempo 等）
OTLP_ENDPOINT=localhost:4318
# 采样率（0.0-1.0，1.0表示100%采样）
TRACING_SAMPLING_RATE=1.0
