# 服务配置
SERVER_PORT=8080
SERVER_HOST=0.0.0.0

# Genkit 配置
GENKIT_API_KEY=your-api-key-here
GENKIT_MODEL=gemini-2.5-flash
GENKIT_DEFAULT_TEMPERATURE=0.7
GENKIT_DEFAULT_MAX_TOKENS=2000

# PostgreSQL 数据库配置
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your-password-here
DB_NAME=genkit_ai_service
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m
# GORM 日志级别: silent, error, warn, info
DB_LOG_LEVEL=warn

# 日志配置
LOG_LEVEL=info
LOG_FORMAT=json

# 会话配置
SESSION_TIMEOUT=30m
SESSION_CLEANUP_INTERVAL=5m
# 摘要生成阈值（消息数量）
SESSION_SUMMARY_THRESHOLD=50
# 默认分页大小
SESSION_DEFAULT_PAGE_SIZE=20
# 最大分页大小
SESSION_MAX_PAGE_SIZE=100
# 会话标题最大长度
SESSION_MAX_TITLE_LENGTH=255

# 模型配置
MODELS_DIR=./models

# JWT 认证配置
# JWT 签名密钥（生产环境必须使用强随机密钥，至少 32 个字符）
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars
# JWT 签发者
JWT_ISSUER=genkit-ai-service
# JWT 受众
JWT_AUDIENCE=genkit-api
# Access Token 生命周期
ACCESS_TOKEN_TTL=60m
# Refresh Token 生命周期（30 天）
REFRESH_TOKEN_TTL=720h

# 密码配置
# Bcrypt cost factor (4-31，推荐 12)
BCRYPT_COST=12
# 密码最小长度
PASSWORD_MIN_LENGTH=8

# 登录安全配置
# 最大登录尝试次数
MAX_LOGIN_ATTEMPTS=5
# 登录尝试时间窗口
LOGIN_ATTEMPT_WINDOW=15m

# Token 策略
# 是否启用 Refresh Token 轮换
ENABLE_REFRESH_ROTATION=true

# 租户识别策略 (header, subdomain, path, cookie)
TENANT_IDENTIFY_STRATEGY=header

# 数据库清理配置
# Token 清理间隔（默认 1 小时）
TOKEN_CLEANUP_INTERVAL=1h

# Redis 配置
# 是否启用 Redis
REDIS_ENABLED=true
# Redis 主机
REDIS_HOST=localhost
# Redis 端口
REDIS_PORT=6379
# Redis 密码（如果没有密码则留空）
REDIS_PASSWORD=
# Redis 数据库编号（0-15）
REDIS_DB=0

# Token 黑名单配置
# 是否启用 Token 黑名单（需要 Redis）
ENABLE_TOKEN_BLACKLIST=true
