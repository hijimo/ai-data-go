# 服务配置
SERVER_PORT=8080
SERVER_HOST=0.0.0.0

# Genkit 配置
GENKIT_API_KEY=your-api-key-here
GENKIT_MODEL=gemini-2.5-flash
GENKIT_DEFAULT_TEMPERATURE=0.7
GENKIT_DEFAULT_MAX_TOKENS=2000

# PostgreSQL 数据库配置
# 
# 方式一：使用 DATABASE_URL（推荐）
# DATABASE_URL 是标准的 PostgreSQL 连接字符串格式
# 格式：postgres://用户名:密码@主机:端口/数据库名?参数
# 示例：DATABASE_URL=postgres://postgres:password@localhost:5432/genkit_ai_service?sslmode=disable
# 
# 方式二：使用独立的配置项（如果设置了 DATABASE_URL，以下配置将被忽略）
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your-password-here
DB_NAME=genkit_ai_service
DB_SSLMODE=disable

# 数据库连接池配置
# 最大打开连接数（建议值：25-100，根据应用负载调整）
DB_MAX_OPEN_CONNS=25
# 最大空闲连接数（建议值：5-25，应小于或等于最大打开连接数）
DB_MAX_IDLE_CONNS=5
# 连接最大生命周期（建议值：5m-30m）
DB_CONN_MAX_LIFETIME=5m

# GORM 日志级别: silent, error, warn, info
# silent: 不输出日志
# error: 只输出错误日志
# warn: 输出警告和错误日志
# info: 输出所有日志（包括 SQL 语句）
DB_LOG_LEVEL=warn

# UUID 扩展说明
# 本项目使用 UUID 作为所有表的主键类型
# PostgreSQL 13+ 内置支持 gen_random_uuid() 函数
# PostgreSQL 13 以下版本需要启用 pgcrypto 扩展：
#   CREATE EXTENSION IF NOT EXISTS "pgcrypto";
# 
# 初始迁移会自动检测并启用所需的 UUID 扩展
# 如果遇到 UUID 相关错误，请确保：
# 1. PostgreSQL 版本 >= 9.4
# 2. 数据库用户具有创建扩展的权限
# 3. 如果使用 RDS 等托管服务，确保已启用 pgcrypto 扩展

# 日志配置
LOG_LEVEL=info
LOG_FORMAT=json

# 会话配置
SESSION_TIMEOUT=30m
SESSION_CLEANUP_INTERVAL=5m
# 摘要生成阈值（消息数量）
SESSION_SUMMARY_THRESHOLD=50
# 默认分页大小
SESSION_DEFAULT_PAGE_SIZE=20
# 最大分页大小
SESSION_MAX_PAGE_SIZE=100
# 会话标题最大长度
SESSION_MAX_TITLE_LENGTH=255

# 模型配置
MODELS_DIR=./models

# JWT 认证配置
# JWT 签名密钥（生产环境必须使用强随机密钥，至少 32 个字符）
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars
# JWT 签发者
JWT_ISSUER=genkit-ai-service
# JWT 受众
JWT_AUDIENCE=genkit-api
# Access Token 生命周期
ACCESS_TOKEN_TTL=60m
# Refresh Token 生命周期（30 天）
REFRESH_TOKEN_TTL=720h

# 密码配置
# Bcrypt cost factor (4-31，推荐 12)
BCRYPT_COST=12
# 密码最小长度
PASSWORD_MIN_LENGTH=8

# 登录安全配置
# 最大登录尝试次数
MAX_LOGIN_ATTEMPTS=5
# 登录尝试时间窗口
LOGIN_ATTEMPT_WINDOW=15m

# Token 策略
# 是否启用 Refresh Token 轮换
ENABLE_REFRESH_ROTATION=true

# 租户识别策略 (header, subdomain, path, cookie)
TENANT_IDENTIFY_STRATEGY=header

# 数据库清理配置
# Token 清理间隔（默认 1 小时）
TOKEN_CLEANUP_INTERVAL=1h

# Redis 配置
# 是否启用 Redis
REDIS_ENABLED=true
# Redis 主机
REDIS_HOST=localhost
# Redis 端口
REDIS_PORT=6379
# Redis 密码（如果没有密码则留空）
REDIS_PASSWORD=
# Redis 数据库编号（0-15）
REDIS_DB=0

# Token 黑名单配置
# 是否启用 Token 黑名单（需要 Redis）
ENABLE_TOKEN_BLACKLIST=true
