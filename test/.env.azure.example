# Azure OpenAI 集成测试环境变量配置示例
# 复制此文件为 .env.azure 并填入实际的配置值

# ========================================
# Azure OpenAI 配置（必需）
# ========================================

# Azure OpenAI API 密钥
# 从 Azure Portal 的 Azure OpenAI 资源中获取
AZURE_OPENAI_API_KEY=your-api-key-here

# Azure OpenAI Endpoint
# 格式：https://{your-resource-name}.openai.azure.com
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com

# Azure OpenAI Deployment 名称
# 这是您在 Azure OpenAI Studio 中创建的部署名称
AZURE_OPENAI_DEPLOYMENT=gpt-4

# ========================================
# Azure OpenAI 配置（可选）
# ========================================

# Azure OpenAI API Version
# 默认值：2024-02-15-preview
# 可选值：2023-12-01, 2024-02-15-preview 等
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# ========================================
# 数据库配置（可选）
# ========================================

# 数据库主机
# 默认值：localhost
DB_HOST=localhost

# 数据库端口
# 默认值：5432
DB_PORT=5432

# 数据库用户
# 默认值：postgres
DB_USER=postgres

# 数据库密码
# 默认值：postgres
DB_PASSWORD=postgres

# 数据库名称
# 默认值：genkit_test
DB_NAME=genkit_test

# ========================================
# 使用说明
# ========================================
#
# 1. 复制此文件：
#    cp test/.env.azure.example test/.env.azure
#
# 2. 编辑 test/.env.azure，填入实际的配置值
#
# 3. 加载环境变量：
#    source test/.env.azure
#
# 4. 运行测试：
#    ./test/test_azure_openai.sh
#
# 或者直接在命令行中设置环境变量：
#    export AZURE_OPENAI_API_KEY="your-key"
#    export AZURE_OPENAI_ENDPOINT="https://your-resource.openai.azure.com"
#    export AZURE_OPENAI_DEPLOYMENT="gpt-4"
#    ./test/test_azure_openai.sh
