# 测试环境配置示例
# 用于多提供商支持的测试环境部署
# 复制此文件为 .env.test 并填入实际值

# ========================================
# 服务器配置
# ========================================
SERVER_PORT=8080
SERVER_HOST=0.0.0.0

# ========================================
# 数据库配置
# ========================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ai_service_test
DB_USER=postgres
DB_PASSWORD=your_test_db_password
DB_SSL_MODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m
DB_LOG_LEVEL=info

# ========================================
# Redis 配置
# ========================================
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_test_redis_password
REDIS_DB=1

# ========================================
# JWT 认证配置
# ========================================
# JWT 签名密钥（测试环境使用固定密钥，生产环境必须使用强随机密钥）
JWT_SECRET=test-jwt-secret-key-32-bytes-long!!
JWT_ISSUER=genkit-ai-service-test
JWT_AUDIENCE=genkit-api-test
ACCESS_TOKEN_TTL=60m
REFRESH_TOKEN_TTL=720h

# ========================================
# 密码和安全配置
# ========================================
BCRYPT_COST=10
PASSWORD_MIN_LENGTH=8
MAX_LOGIN_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW=15m
ENABLE_REFRESH_ROTATION=true
ENABLE_TOKEN_BLACKLIST=true

# ========================================
# 租户识别策略
# ========================================
TENANT_IDENTIFY_STRATEGY=header

# ========================================
# 日志配置
# ========================================
LOG_LEVEL=debug
LOG_FORMAT=json
LOG_ENABLE_FILE=true
LOG_DIR=logs
LOG_ENABLE_CONSOLE=true

# ========================================
# Google AI (Gemini) 配置
# ========================================
# 注意：这些环境变量仅用于向后兼容
# 新的多提供商架构使用 model_configurations 表存储配置
GOOGLE_API_KEY=your_google_api_key_here
GENKIT_API_KEY=your_google_api_key_here
GENKIT_MODEL=gemini-2.0-flash-exp
GENKIT_DEFAULT_TEMPERATURE=0.7
GENKIT_DEFAULT_MAX_TOKENS=2000

# ========================================
# Azure OpenAI 配置
# ========================================
# 用于测试 Azure OpenAI 提供商
AZURE_OPENAI_API_KEY=your_azure_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-4
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# ========================================
# 阿里云百炼配置
# ========================================
# 用于测试百炼提供商
BAILIAN_API_KEY=your_bailian_api_key_here
BAILIAN_ENDPOINT=https://dashscope.aliyuncs.com
BAILIAN_WORKSPACE=default

# ========================================
# 向量数据库配置（可选）
# ========================================
QDRANT_ACCESS_KEY=
QDRANT_ENDPOINT=
QDRANT_CLUSTER_ID=

# ========================================
# 缓存 TTL 配置（秒）
# ========================================
CACHE_CONTEXT_TTL=300
CACHE_VECTOR_RESULT_TTL=1800
CACHE_SUMMARY_TTL=3600
CACHE_SESSION_LIST_TTL=600
CACHE_TOKEN_USAGE_TTL=300

# ========================================
# 系统初始化配置
# ========================================
PLATFORM_ADMIN_EMAIL=admin@test.local
PLATFORM_ADMIN_PASSWORD=Test@Admin123
PLATFORM_ADMIN_NAME=Test Admin
PLATFORM_TENANT_NAME=Test Platform
PLATFORM_TENANT_DOMAIN=test.local

# ========================================
# 模型配置加密
# ========================================
# API密钥加密密钥（必须是32字节）
ENCRYPTION_SECRET_KEY=test-encryption-key-32-bytes!!
# 模型配置验证超时时间（秒）
PROVIDER_VALIDATION_TIMEOUT=30

# ========================================
# 追踪配置
# ========================================
TRACING_ENABLED=true
TRACING_SERVICE_NAME=genkit-ai-service-test
TRACING_SERVICE_VERSION=1.0.0
TRACING_ENVIRONMENT=test
OTLP_ENDPOINT=localhost:4318
TRACING_SAMPLING_RATE=1.0

# ========================================
# Token 清理配置
# ========================================
TOKEN_CLEANUP_INTERVAL=1h

# ========================================
# 测试租户配置
# ========================================
# 用于集成测试的测试租户ID
TEST_TENANT_ID=738dbb1f-83e6-4bf5-935c-f0498236440d
# 测试租户管理员Token（运行测试前需要先登录获取）
TEST_TENANT_ADMIN_TOKEN=
